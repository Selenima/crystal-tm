@* partial таблицы задач, используется на странице списка и при фильтрации *@
@model TaskIndexViewModel

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>Задача</th><th>Проект</th><th>Исполнитель</th><th>Приоритет</th><th>Статус</th><th></th></tr></thead>
            <tbody>
            @if (!Model.Tasks.Any())
            {
                <tr><td colspan="6" class="text-center py-4 text-muted">Ничего не найдено.</td></tr>
            }
            else
            {
                foreach (var task in Model.Tasks)
                {
                    <tr>
                        <td><div class="fw-semibold">@task.Title</div><div class="small text-muted">@task.Description</div></td>
                        <td>@task.ProjectEntity?.Name</td>
                        <td>@task.AssignedTo?.FullName</td>
                        <td>@task.Priority</td>
                        <td><span class="badge text-bg-@(task.TaskStatusEntity?.ColorClass ?? "secondary")">@task.TaskStatusEntity?.Name</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@task.Id">Открыть</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@task.Id">Изменить</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex gap-2 mt-3">
        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            <a href="#" class="btn @(i == Model.Page ? "btn-primary" : "btn-outline-primary") task-page-link" data-page="@i">@i</a>
        }
    </div>
}
