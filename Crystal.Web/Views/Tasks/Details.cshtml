@* страница деталей задачи, показывает поля задачу статус и комментарии *@
@model TaskDetailsViewModel
@{
    ViewData["Title"] = "Задача";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Task.Title</h1>
        <p class="text-muted mb-0">Проект: @Model.Task.ProjectEntity?.Name | Статус: @Model.Task.TaskStatusEntity?.Name</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Task.Id">Изменить</a>
        <form method="post" asp-action="Delete" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Task.Id" />
            <button type="submit" class="btn btn-outline-danger">Удалить</button>
        </form>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-body shadow-sm h-100">
            <p><strong>Описание:</strong><br />@Model.Task.Description</p>
            <p><strong>Очередь:</strong> @Model.Task.WorkQueue?.Name</p>
            <p><strong>Исполнитель:</strong> @Model.Task.AssignedTo?.FullName</p>
            <p><strong>Создатель:</strong> @Model.Task.CreatedBy?.FullName</p>
            <p><strong>Дедлайн:</strong> @Model.Task.Deadline?.ToString("dd.MM.yyyy")</p>
            <p><strong>Приоритет:</strong> @Model.Task.Priority</p>

            <div class="border rounded p-3 mb-3">
                <div class="fw-semibold mb-2">Изменение статуса</div>
                <div class="small text-muted mb-2">Текущий статус: @Model.Task.TaskStatusEntity?.Name</div>
                @if (TempData["StatusError"] is string error)
                {
                    <div class="alert alert-warning py-2">@error</div>
                }
                @if (!Model.AllowedTransitions.Any())
                {
                    <div class="text-muted">Для этого статуса нет доступных переходов.</div>
                }
                else
                {
                    <form method="post" asp-action="ChangeStatus" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Task.Id" />
                        <select name="statusId" class="form-select">
                            @foreach (var item in Model.AllowedTransitions)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary">Перевести</button>
                    </form>
                }
            </div>

            <h2 class="h5 mt-3">Поля</h2>
            @if (!Model.Task.FieldValues.Any())
            {
                <p class="text-muted mb-0">Дополнительных полей нет.</p>
            }
            else
            {
                foreach (var item in Model.Task.FieldValues)
                {
                    <div class="mb-2"><strong>@item.TaskFieldDefinition?.Name:</strong> @item.Value</div>
                }
            }
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card card-body shadow-sm">
            <h2 class="h5 mb-3">Комментарии</h2>
            <form id="commentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="taskId" value="@Model.Task.Id" />
                <textarea id="commentText" class="form-control" rows="3" placeholder="Введите комментарий"></textarea>
                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-primary">Добавить</button>
                    <button id="reloadComments" type="button" class="btn btn-outline-secondary">Обновить</button>
                </div>
            </form>
            <div id="commentError" class="text-danger mt-2"></div>
            <div id="commentsContainer" class="mt-3">
                <partial name="_CommentsList" model="Model.Task.Comments.OrderByDescending(x => x.CreatedAt)" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadComments() {
            $.get('/Tasks/Comments', { id: $('#taskId').val() })
                .done(function (html) {
                    $('#commentsContainer').html(html);
                    $('#commentError').text('');
                })
                .fail(function () {
                    $('#commentError').text('Не удалось загрузить комментарии.');
                });
        }

        $('#reloadComments').on('click', function () { loadComments(); });

        $('#commentForm').on('submit', function (event) {
            event.preventDefault();
            $.ajax({
                url: '/Tasks/AddComment',
                method: 'POST',
                data: {
                    __RequestVerificationToken: $('#commentForm input[name="__RequestVerificationToken"]').val(),
                    taskId: $('#taskId').val(),
                    comment: $('#commentText').val()
                }
            }).done(function (html) {
                $('#commentsContainer').html(html);
                $('#commentText').val('');
                $('#commentError').text('');
            }).fail(function (xhr) {
                $('#commentError').text(xhr.responseText || 'Не удалось сохранить комментарий.');
            });
        });
    </script>
}
