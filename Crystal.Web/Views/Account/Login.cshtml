@* страница входа, отправляет email и пароль в AccountController *@
@model LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-xl-4">
        <div class="card card-body shadow-lg">
            <div class="text-center mb-4">
                <h1 class="h3 mb-1">Вход в систему</h1>
                <p class="text-muted mb-0">Войди как пользователь или администратор.</p>
            </div>

            <div class="alert alert-info">
                <div><strong>Админ:</strong> admin@crystal.local / admin123</div>
                <div><strong>Пользователь:</strong> anna@crystal.local / anna123</div>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Войти</button>
            </form>
        </div>
    </div>
</div>
