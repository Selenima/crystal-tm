@* форма правила перехода, говорит из какого статуса в какой можно перейти *@
@model StatusTransitionEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Новый переход" : "Редактирование перехода";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="Id" type="hidden" />
    <div class="mb-3">
        <label asp-for="FromTaskStatusEntityId" class="form-label"></label>
        <select asp-for="FromTaskStatusEntityId" asp-items="Model.Statuses" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="ToTaskStatusEntityId" class="form-label"></label>
        <select asp-for="ToTaskStatusEntityId" asp-items="Model.Statuses" class="form-select"></select>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>
    </div>
</form>
