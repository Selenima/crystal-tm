@* форма пользователя, админ задает профиль роль очередь и доступ к проектам *@
@model UserEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Новый пользователь" : "Редактирование пользователя";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="Id" type="hidden" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control"/>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control"/>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control"/>
        </div>
        <div class="col-md-6">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control"/>
        </div>
        <div class="col-md-6">
            <label asp-for="Position" class="form-label"></label>
            <input asp-for="Position" class="form-control"/>
        </div>
        <div class="col-md-6">
            <label asp-for="Department" class="form-label"></label>
            <input asp-for="Department" class="form-control"/>
        </div>
        <div class="col-md-6">
            <label asp-for="WorkQueueId" class="form-label"></label>
            <select asp-for="WorkQueueId" asp-items="Model.Queues" class="form-select">
                <option value="">Без очереди</option>
            </select>
        </div>
        <div class="col-md-6 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="IsAdmin" class="form-check-input"/>
                <label asp-for="IsAdmin" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-12">
            <label asp-for="SelectedProjectIds" class="form-label"></label>
            <select asp-for="SelectedProjectIds" asp-items="Model.Projects" class="form-select" multiple size="6"></select>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>
    </div>
</form>
